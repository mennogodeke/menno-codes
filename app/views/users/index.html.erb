<% content_for(:title, "Users") %>

<h2>Users</h2>
<p><%= link_to "New user", new_user_path %></p>

<ul>
  <% @users.each do |user| %>
    <li>
      <%= link_to user.username, user %> — <%= user.role %>
      · <%= link_to "Edit", edit_user_path(user) %>
      <% unless user == Current.user %>
        · <%= button_to "Delete", user, method: :delete, form: { data: { turbo_confirm: "Delete #{user.username}?" } } %>
      <% end %>
    </li>
  <% end %>
</ul>
