<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-theme="retro">
  <head>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="menno.codes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a class="skip-link" href="#content">Skip to content</a>

    <main id="content" class="page">
      <%= render "shared/wordmark" %>

      <hr class="rule-soft">
      <nav class="menu" aria-label="Primary">
        <% nav_items.each_with_index do |item, i| %>
          <% if i.positive? %><span class="menu__sep" aria-hidden="true">·</span><% end %>
          <%= nav_link(item) %>
        <% end %>
      </nav>
      <hr class="rule-soft">

      <%= yield %>
    </main>

    <footer class="site-footer">
      <% if locale_switcher? %>
        <span class="switcher">
          <% NavigationHelper::LOCALES.each do |locale| %>
            <%= locale_switch_link(locale) %>
          <% end %>
        </span>
      <% end %>

      <a class="site-footer__source" href="https://github.com/mennogodeke"><%= t("footer.source") %></a>

      <span class="site-footer__auth">
        <% if authenticated? %>
          <%= link_to t("footer.my_page"), user_path(Current.user) %>
          <span aria-hidden="true">·</span>
          <%= button_to t("footer.sign_out"), session_path, method: :delete, class: "site-footer__signout" %>
        <% else %>
          <%= link_to t("footer.sign_in"), new_session_path %>
        <% end %>
      </span>
    </footer>
  </body>
</html>
